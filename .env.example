# Required
DEEPL_API_KEY=your_deepl_api_key_here

# Optional
DEEPL_FREE_API=true
GROQ_API_KEY=    # free key from console.groq.com, no credit card needed
GROQ_STT_MODEL=whisper-large-v3-turbo
